{
	"schemaVersion": 1,
	"id": "shortcutspanel",
	"version": "${version}",
	"name": "Shortcuts Panel",
	"description": "A searchable palette for every keybind (vanilla and modded), with history, favorites and instant rebinding.",
	"authors": ["wlm3201"],
	"contact": {
		"sources": "https://github.com/wlm3201/shortcuts-panel"
	},
	"license": "MIT",
	"icon": "assets/shortcutspanel/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["com.shortcutspanel.client.ShortcutsPanelClient"]
	},
	"accessWidener": "shortcutspanel.accesswidener",
	"depends": {
		"fabricloader": ">=0.19.5",
		"java": ">=25",
		"minecraft": "${minecraft_dependency}",
		"fabric-api": "*"
	},
	"suggests": {
		"malilib": "*"
	}
}
